{
  "name": "dsh-grokbot-pet",
  "version": "2.1.0",
  "description": "GrokBot desktop pet for DeepSeek Harness (Web GUI and Desktop app): draggable animated companion over the live conversation snapshot",
  "license": "MIT",
  "type": "module",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PAKIKNOWLEDGE/GrokBot_in_DeepseekHerness.git"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./invariant": "./lib/invariant.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "clean": "node -e \"fs.rmSync('lib',{recursive:true,force:true})\"",
    "bundle": "npm run clean && tsdown",
    "build": "npm run clean && tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/store.spec.ts tests/node-plugin.client.spec.ts",
    "prepare": "tsdown"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-cordis-client-runner"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-invariants": ">=0.0.1-rc.1 <0.3.0-0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-invariants": ">=0.0.1-rc.1 <0.3.0-0",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
